  card: {fileID: 1375673099}
  cardTitle: {fileID: 1076034273}
  cardBody: {fileID: 1370595025}
  cardStamp: {fileID: 898265141}
  lessonPanel: {fileID: 774368620}
  lessonText: {fileID: 283130955}
