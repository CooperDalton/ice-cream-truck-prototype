  m_Text: 'CONTROLS

    <color=#ffe14a>WASD</color>  move

    <color=#ffe14a>SHIFT</color> 
    run

    <color=#ffe14a>SPACE</color>  jump

    <color=#ffe14a>CLICK</color> 
    shove / shoot / plop scoops

    <color=#ffe14a>E</color>  use

    <color=#ffe14a>Q</color> 
    drop  (hold to throw)

    <color=#ffe14a>1-4 / WHEEL</color>  hotbar

    <color=#ffe14a>RIGHT
    CLICK</color>  jingle (driving)

    <color=#ffe14a>F1</color>  hide this'
