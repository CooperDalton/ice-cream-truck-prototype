  m_Text: 'CONTROLS

    <color=#ffe14a>WASD</color>  move

    <color=#ffe14a>SHIFT</color> 
    sprint

    <color=#ffe14a>C</color>  crouch

    <color=#ffe14a>SPACE</color> 
    jump

    <color=#ffe14a>CLICK</color>  use / shoot

    <color=#ffe14a>R</color> 
    reload

    <color=#ffe14a>E</color>  interact

    <color=#ffe14a>Q</color> 
    drop  (hold to throw)

    <color=#ffe14a>1-6 / WHEEL</color>  hotbar

    <color=#ffe14a>F1</color> 
    hide this'
